// mock-scope.kz — the τ³ mock domain's tool surface, as a Koru register block.
//
// Declared in its own module, not the entry: a registered scope survives the
// module boundary (115_036). This is the mock domain's ENTIRE agent-facing
// vocabulary — the four tools the harness actually executes (in Python, on its
// fake database) plus `say`, the voice channel that is the refusal surface in
// τ³ (a correct refusal = say + no tool call).
//
// The procs are stubs on purpose. τ³ executes the real tools against its DB
// and scores the end-state; the gate's job is to prove an invocation is IN
// this vocabulary before Python lets it reach the harness. What the procs do
// here is nothing; what being IN THE BLOCK does is everything — the same
// register transform that refuses a forged handle in the notes agent refuses
// a hallucinated verb here.

~import std/runtime

const std = @import("std");

~pub tor create-task { user_id: string, title: string, description: string = "" }

~proc create-task|zig {
    _ = user_id;
    _ = title;
    _ = description;
}

~pub tor get-users {}

~proc get-users|zig {}

~pub tor update-task-status { task_id: string, status: string }

~proc update-task-status|zig {
    _ = task_id;
    _ = status;
}

~pub tor transfer-to-human-agents { summary: string }

~proc transfer-to-human-agents|zig {
    _ = summary;
}

~pub tor say { text: string }

~proc say|zig {
    _ = text;
}

~std/runtime:register(scope: "mock") {
    create-task(10)
    get-users(1)
    update-task-status(10)
    transfer-to-human-agents(1)
    say(1)
}