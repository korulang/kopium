// ============================================================================
// THE TYPED SPINE — select / hold / release / confirm
// ============================================================================

// Membership is the whole point: the chosen flights are cut FROM the minted
// result set, so a flight_number the search never returned is `miss`, not a
// fabricated booking leg. Onestop pairs come back whole — booking the pair
// is the only honest read of a one-stop itinerary.
~pub tor select { flights: string<found>, flight_number: string, date: string }
| chosen string<chosen!>
| miss string

~proc select|zig {
    const doc = yj.c.yyjson_read(@constCast(flights.ptr), flights.len, 0) orelse
        return .{ .miss = "the held search result did not parse" };
    defer yj.c.yyjson_doc_free(doc);
    const root = yj.c.yyjson_doc_get_root(doc);
    if (!yj.c.yyjson_is_arr(root))
        return .{ .miss = "the held search result was not a list of flights" };

    var legs = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
    defer legs.deinit(std.heap.page_allocator);
    const w = legs.writer(std.heap.page_allocator);
    var nlegs: usize = 0;
    var origin: []const u8 = "";
    var destination: []const u8 = "";

    // Emit one leg as a bare {flight_number, date} — the only shape
    // book_reservation takes. A leg's own `date` wins (a onestop second leg
    // can depart next-day); a direct result carries none, so the arg's date
    // stands in.
    const emitLeg = struct {
        fn go(wr: anytype, leg: *yj.c.yyjson_val, fallback_date: []const u8, count: *usize, o: *[]const u8, d: *[]const u8) bool {
            const fn_s = __jstr(__jfield(leg, "flight_number")) orelse return false;
            const d_s = __jstr(__jfield(leg, "date")) orelse fallback_date;
            wr.print("{s}\"flight_number\": \"{s}\", \"date\": \"{s}\"}}", .{ if (count.* > 0) ", {" else "{", fn_s, d_s }) catch return false;
            count.* += 1;
            if (count.* == 1) o.* = __jstr(__jfield(leg, "origin")) orelse "";
            d.* = __jstr(__jfield(leg, "destination")) orelse "";
            return true;
        }
    }.go;

    var i: usize = 0;
    const n = yj.c.yyjson_arr_size(root);
    var matched = false;
    while (i < n) : (i += 1) {
        const item = yj.c.yyjson_arr_get(root, i) orelse continue;
        if (yj.c.yyjson_is_obj(item)) {
            // direct result: one flight per element
            const fn_s = __jstr(__jfield(item, "flight_number")) orelse continue;
            if (std.mem.eql(u8, fn_s, flight_number)) {
                matched = true;
                _ = emitLeg(w, item, date, &nlegs, &origin, &destination);
            }
        } else if (yj.c.yyjson_is_arr(item)) {
            // onestop pair: a match on either leg takes the whole pair
            var in_pair = false;
            var j: usize = 0;
            const m = yj.c.yyjson_arr_size(item);
            while (j < m) : (j += 1) {
                const leg = yj.c.yyjson_arr_get(item, j) orelse continue;
                const fn_s = __jstr(__jfield(leg, "flight_number")) orelse continue;
                if (std.mem.eql(u8, fn_s, flight_number)) in_pair = true;
            }
            if (in_pair) {
                matched = true;
                j = 0;
                while (j < m) : (j += 1) {
                    const leg = yj.c.yyjson_arr_get(item, j) orelse continue;
                    _ = emitLeg(w, leg, date, &nlegs, &origin, &destination);
                }
            }
        }
    }
    if (!matched) {
        return .{ .miss = std.fmt.allocPrint(std.heap.page_allocator,
            "no flight '{s}' in that result — select may only name what a search minted", .{flight_number}) catch "no such flight in the held result" };
    }
    const out = std.fmt.allocPrint(std.heap.page_allocator,
        "{{\"flights\": [{s}], \"origin\": \"{s}\", \"destination\": \"{s}\"}}",
        .{ legs.items, origin, destination }) catch @panic("kopium: select result OOM");
    return .{ .chosen = out };
}

// hold gathers everything book_reservation needs into ONE pending
// commitment. The payment_id is checked against the minted user record —
// a payment method the user never had is `refused`, not an env call.
~pub tor hold { user: string<user-known>, flights: string<chosen>, passengers: string, payment_id: string, amount: i64, cabin: string, flight_type: string, total_baggages: i64, nonfree_baggages: i64, insurance: string }
| held string<held!>
| refused string

~proc hold|zig {
    const udoc = yj.c.yyjson_read(@constCast(user.ptr), user.len, 0) orelse
        return .{ .refused = "the held user record did not parse" };
    defer yj.c.yyjson_doc_free(udoc);
    const uroot = yj.c.yyjson_doc_get_root(udoc);
    const uid = __jstr(__jfield(uroot, "user_id")) orelse
        return .{ .refused = "the held user record carries no user_id" };
    const pms = __jfield(uroot, "payment_methods") orelse
        return .{ .refused = "the held user record carries no payment_methods" };
    if (__jfield(pms, payment_id) == null) {
        // Teach with the real keys — the refusal names what exists.
        var keys = std.ArrayList(u8){ .items = &.{}, .capacity = 0 };
        defer keys.deinit(std.heap.page_allocator);
        const kw = keys.writer(std.heap.page_allocator);
        var iter: yj.c.yyjson_obj_iter = undefined;
        var first = true;
        if (yj.c.yyjson_obj_iter_init(pms, &iter)) {
            while (yj.c.yyjson_obj_iter_next(&iter)) |k| {
                const ks = __jstr(k) orelse continue;
                kw.print("{s}\"{s}\"", .{ if (first) "" else ", ", ks }) catch {};
                first = false;
            }
        }
        return .{ .refused = std.fmt.allocPrint(std.heap.page_allocator,
            "payment_id '{s}' is not among this user's payment methods — they are: {s}", .{ payment_id, keys.items }) catch "payment_id not in the user's methods" };
    }

    const fdoc = yj.c.yyjson_read(@constCast(flights.ptr), flights.len, 0) orelse
        return .{ .refused = "the held selection did not parse" };
    defer yj.c.yyjson_doc_free(fdoc);
    const froot = yj.c.yyjson_doc_get_root(fdoc);
    const legs_v = __jfield(froot, "flights") orelse
        return .{ .refused = "the held selection carries no flights" };
    const o_s = __jstr(__jfield(froot, "origin")) orelse
        return .{ .refused = "the held selection carries no origin" };
    const d_s = __jstr(__jfield(froot, "destination")) orelse
        return .{ .refused = "the held selection carries no destination" };
    var legs_len: usize = 0;
    const legs_raw = yj.c.yyjson_val_write(legs_v, 0, &legs_len) orelse
        return .{ .refused = "the held selection's flights would not render" };
    defer yj.c.free(legs_raw);

    var e0: [1024]u8 = undefined;
    const uid_v = __jsonEsc(uid, &e0);
    var e1: [256]u8 = undefined;
    const o_v = __jsonEsc(o_s, &e1);
    var e2: [256]u8 = undefined;
    const d_v = __jsonEsc(d_s, &e2);
    var e3: [256]u8 = undefined;
    const ft_v = __jsonEsc(flight_type, &e3);
    var e4: [256]u8 = undefined;
    const cab_v = __jsonEsc(cabin, &e4);
    var e5: [256]u8 = undefined;
    const pid_v = __jsonEsc(payment_id, &e5);
    var e6: [64]u8 = undefined;
    const ins_v = __jsonEsc(insurance, &e6);

    const args = std.fmt.allocPrint(std.heap.page_allocator,
        "{{\"user_id\": \"{s}\", \"origin\": \"{s}\", \"destination\": \"{s}\", \"flight_type\": \"{s}\", \"cabin\": \"{s}\", \"flights\": {s}, \"passengers\": {s}, \"payment_methods\": [{{\"payment_id\": \"{s}\", \"amount\": {d}}}], \"total_baggages\": {d}, \"nonfree_baggages\": {d}, \"insurance\": \"{s}\"}}",
        .{ uid_v, o_v, d_v, ft_v, cab_v, legs_raw[0..legs_len], passengers, pid_v, amount, total_baggages, nonfree_baggages, ins_v }) catch @panic("kopium: hold args OOM");
    return .{ .held = args };
}

// Registered BEFORE confirm: auto-discharge takes the first non-reissuing
// discharger, and a hang-up must release — never book.
~pub tor release { held: string<!held> } -> string

~proc release|zig {
    _ = held;
    return "released — the booking was not placed";
}

~pub tor confirm { held: string<!held> } -> string<reservation-known!>

~proc confirm|zig {
    return @import("root").koru_app.koru_tau_wire.callIO("book_reservation", held);
}

// ============================================================================
// RESERVATION LIFECYCLE — borrow the minted record, extract the real id
// ============================================================================

~pub tor cancel-reservation { reservation: string<reservation-known> } -> string

~proc cancel-reservation|zig {
    const doc = yj.c.yyjson_read(@constCast(reservation.ptr), reservation.len, 0) orelse
        @panic("kopium: held reservation record did not parse");
    defer yj.c.yyjson_doc_free(doc);
    const rid = __jstr(__jfield(yj.c.yyjson_doc_get_root(doc), "reservation_id")) orelse
        @panic("kopium: held reservation record carries no reservation_id");
    var e0: [256]u8 = undefined;
    const rid_v = __jsonEsc(rid, &e0);
    var buf: [512]u8 = undefined;
    const args = std.fmt.bufPrint(&buf,
        "{{\"reservation_id\": \"{s}\"}}", .{rid_v}) catch @panic("kopium: cancel args exceed scratch");
    return @import("root").koru_app.koru_tau_wire.callIO("cancel_reservation", args);
}

~pub tor update-reservation-flights { reservation: string<reservation-known>, flights: string<chosen>, cabin: string, payment_id: string } -> string<reservation-known!>

~proc update-reservation-flights|zig {
    const rdoc = yj.c.yyjson_read(@constCast(reservation.ptr), reservation.len, 0) orelse
        @panic("kopium: held reservation record did not parse");
    defer yj.c.yyjson_doc_free(rdoc);
    const rid = __jstr(__jfield(yj.c.yyjson_doc_get_root(rdoc), "reservation_id")) orelse
        @panic("kopium: held reservation record carries no reservation_id");
    const fdoc = yj.c.yyjson_read(@constCast(flights.ptr), flights.len, 0) orelse
        @panic("kopium: held selection did not parse");
    defer yj.c.yyjson_doc_free(fdoc);
    const legs_v = __jfield(yj.c.yyjson_doc_get_root(fdoc), "flights") orelse
        @panic("kopium: held selection carries no flights");
    var legs_len: usize = 0;
    const legs_raw = yj.c.yyjson_val_write(legs_v, 0, &legs_len) orelse
        @panic("kopium: held selection's flights would not render");
    defer yj.c.free(legs_raw);

    var e0: [256]u8 = undefined;
    const rid_v = __jsonEsc(rid, &e0);
    var e1: [256]u8 = undefined;
    const cab_v = __jsonEsc(cabin, &e1);
    var e2: [256]u8 = undefined;
    const pid_v = __jsonEsc(payment_id, &e2);
    const args = std.fmt.allocPrint(std.heap.page_allocator,
        "{{\"reservation_id\": \"{s}\", \"cabin\": \"{s}\", \"flights\": {s}, \"payment_id\": \"{s}\"}}",
        .{ rid_v, cab_v, legs_raw[0..legs_len], pid_v }) catch @panic("kopium: update_reservation_flights args OOM");
    return @import("root").koru_app.koru_tau_wire.callIO("update_reservation_flights", args);
}

~pub tor update-reservation-baggages { reservation: string<reservation-known>, total_baggages: i64, nonfree_baggages: i64, payment_id: string } -> string<reservation-known!>

~proc update-reservation-baggages|zig {
    const rdoc = yj.c.yyjson_read(@constCast(reservation.ptr), reservation.len, 0) orelse
        @panic("kopium: held reservation record did not parse");
