~pub tor say { text: string } -> string

~proc say|zig {
    return @import("root").koru_app.koru_tau_wire.sayIO(text);
}

~pub tor search-direct-flight { origin: string, destination: string, date: string } -> string<found!>

~proc search-direct-flight|zig {
    const __S = struct { threadlocal var buf: [1024]u8 = undefined; };
    var __e0: [1024]u8 = undefined;
    const origin_v = __jsonEsc(origin, &__e0);
    var __e1: [1024]u8 = undefined;
    const destination_v = __jsonEsc(destination, &__e1);
    var __e2: [1024]u8 = undefined;
    const date_v = __jsonEsc(date, &__e2);
    const __args = std.fmt.bufPrint(&__S.buf,
        "{{\"origin\": \"{s}\", \"destination\": \"{s}\", \"date\": \"{s}\"}}",
        .{ origin_v, destination_v, date_v }) catch @panic("kopium: search_direct_flight args exceed scratch");
    return @import("root").koru_app.koru_tau_wire.callIO("search_direct_flight", __args);
}

