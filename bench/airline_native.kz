    var e0: [256]u8 = undefined;
    const rid_v = __jsonEsc(rid, &e0);
    var e1: [256]u8 = undefined;
    const pid_v = __jsonEsc(payment_id, &e1);
    const args = std.fmt.allocPrint(std.heap.page_allocator,
        "{{\"reservation_id\": \"{s}\", \"total_baggages\": {d}, \"nonfree_baggages\": {d}, \"payment_id\": \"{s}\"}}",
        .{ rid_v, total_baggages, nonfree_baggages, pid_v }) catch @panic("kopium: update_reservation_baggages args OOM");
    return @import("root").koru_app.koru_tau_wire.callIO("update_reservation_baggages", args);
}

