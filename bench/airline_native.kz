// What a minted handle CARRIES — the possession type says you hold it, this
// says what it is. Wire-visible so the model can ask mid-session; vocab-doc
// also runs it at boot and appends it to the prompt.
~pub tor describe-handles {} -> string
~proc describe-handles|zig {
    return
        "<found> — a search result list; each leg carries flight_number, origin, destination, scheduled times, date, available_seats, prices\n" ++
        "<user-known> — the user record: user_id, name, address, email, dob, payment_methods (their ids — gift cards, certificates, credit cards — and amounts), saved_passengers, membership, reservations\n" ++
        "<chosen> — the legs select cut out: {flights: [{flight_number, date}], origin, destination}\n" ++
        "<held> — the prepared book_reservation arguments, waiting for confirm or release\n" ++
        "<reservation-known> — the reservation record: reservation_id, user_id, flights, passengers, payment_history, total_baggages, nonfree_baggages, insurance, status, total_price";
}

// AMBIENT RETIREMENT — every minted tag needs a discharger or the bridge's
// hang-up calls it a leak. These are no-ops: a search result or a user
// record is a capability, not a resource claim — there is nothing to
// release env-side, only the obligation to retire. The model may call them
// to drop a stale result; at hang-up the bridge fires them on leftovers.
~pub tor drop-search { found: string<!found> } -> string
~proc drop-search|zig {
    _ = found;
    return "search result dropped";
}

~pub tor drop-choice { chosen: string<!chosen> } -> string
~proc drop-choice|zig {
    _ = chosen;
    return "selection dropped";
}

~pub tor drop-user { user: string<!user-known> } -> string
~proc drop-user|zig {
    _ = user;
    return "user record dropped";
}

~pub tor drop-reservation { reservation: string<!reservation-known> } -> string
~proc drop-reservation|zig {
    _ = reservation;
    return "reservation record dropped";
}

~pub tor send-certificate { user: string<user-known>, amount: i64 } -> string

~proc send-certificate|zig {
    const udoc = yj.c.yyjson_read(@constCast(user.ptr), user.len, 0) orelse
        @panic("kopium: held user record did not parse");
    defer yj.c.yyjson_doc_free(udoc);
    const uid = __jstr(__jfield(yj.c.yyjson_doc_get_root(udoc), "user_id")) orelse
        @panic("kopium: held user record carries no user_id");
    var e0: [256]u8 = undefined;
    const uid_v = __jsonEsc(uid, &e0);
    const args = std.fmt.allocPrint(std.heap.page_allocator,
        "{{\"user_id\": \"{s}\", \"amount\": {d}}}", .{ uid_v, amount }) catch @panic("kopium: send_certificate args OOM");
    return @import("root").koru_app.koru_tau_wire.callIO("send_certificate", args);
}

~pub tor transfer-to-human-agents { summary: string } -> string

~proc transfer-to-human-agents|zig {
    var e0: [1024]u8 = undefined;
    const summary_v = __jsonEsc(summary, &e0);
    var buf: [2048]u8 = undefined;
    const args = std.fmt.bufPrint(&buf,
        "{{\"summary\": \"{s}\"}}", .{summary_v}) catch @panic("kopium: transfer args exceed scratch");
    return @import("root").koru_app.koru_tau_wire.callIO("transfer_to_human_agents", args);
}

// release BEFORE confirm is load-bearing: `get_discharge_event` returns the
// first non-reissuing discharger in register order, and a session hang-up
// must release an abandoned hold — never fire book_reservation on it.
~std/runtime:register(scope: "airline-native") {
    say(1)
    list-all-airports(1)
    calculate(1)
    get-flight-status(1)
    search-direct-flight(1)
    search-onestop-flight(1)
    get-user-details(1)
    get-reservation-details(1)
    select(2)
    hold(2)
    release(1)
    confirm(10)
    cancel-reservation(10)
    update-reservation-flights(10)
    update-reservation-baggages(10)
    update-reservation-passengers(10)
    send-certificate(10)
    transfer-to-human-agents(1)
    drop-search(1)
    drop-choice(1)
    drop-user(1)
    drop-reservation(1)
    describe-handles(1)
}
