// airline_native.kz — the Koru-native arm. Hand-authored register block:
// the phantom layer IS the experiment, so it lives in the declaration, not
// a generator.
//
// What the types enforce, that the transliterated surface cannot:
//   search-*            -> string<found!>              mints a result set
//   select(flights: string<found>, ...)                borrows it — a literal
//     or foreign handle refuses before the proc runs. Membership-checked:
//     a flight_number not IN the result comes back `miss`, never books.
//   get-user-details    -> string<user-known!>
//   get-reservation-details -> string<reservation-known!>
//   hold(user: <user-known>, flights: <chosen>, ...)   validates payment_id
//     against the minted user record, derives origin/destination from the
//     chosen legs, and mints <held!> whose VALUE is the prepared
//     book_reservation args — one obligation, one pending commitment.
//   release(held: string<!held>)                       spends it, no env call.
//   confirm(held: string<!held>) -> <reservation-known!>  spends it INTO the
//     one book_reservation env call. `release` is registered first so a
//     hang-up's auto-discharge releases — an abandoned hold can never book.
//   cancel / update-* borrow <reservation-known> — the reservation_id the
//     env actually vended comes out of the handle, so a fabricated ID is a
//     wire-level refusal, not an env roundtrip. Borrow, not consume: a
//     hang-up must never fire cancel on the env.

~import std/runtime
~import app/tau_wire

const std = @import("std");
const yj = @import("root").koru_koru.koru_yyjson;

// JSON-escape a runtime string for splicing inside a quoted JSON field —
// same contract as airline_tools: model bytes can carry quotes/newlines.
fn __jsonEsc(s: []const u8, buf: []u8) []const u8 {
    var i: usize = 0;
    for (s) |c| {
        if (c < 0x20 or c == '"' or c == '\\') {
            var tmp: [8]u8 = undefined;
            const rep: []const u8 = switch (c) {
                '"' => "\\\"",
                '\\' => "\\\\",
                '\n' => "\\n",
                '\r' => "\\r",
                '\t' => "\\t",
                else => std.fmt.bufPrint(&tmp, "\\u{x:0>4}", .{c}) catch @panic("kopium: escape scratch overflow"),
            };
            if (i + rep.len > buf.len) @panic("kopium: arg string exceeds JSON scratch");
            @memcpy(buf[i..][0..rep.len], rep);
            i += rep.len;
        } else {
            if (i >= buf.len) @panic("kopium: arg string exceeds JSON scratch");
            buf[i] = c;
            i += 1;
        }
    }
    return buf[0..i];
}

fn __jstr(v: ?*yj.c.yyjson_val) ?[]const u8 {
    const x = v orelse return null;
    if (!yj.c.yyjson_is_str(x)) return null;
    const p = yj.c.yyjson_get_str(x) orelse return null;
    return p[0..yj.c.yyjson_get_len(x)];
}

fn __jfield(obj: ?*yj.c.yyjson_val, key: []const u8) ?*yj.c.yyjson_val {
    const o = obj orelse return null;
    return yj.c.yyjson_obj_getn(o, key.ptr, key.len);
}

