// gen_airline.kz — the airline register-block generator, in Koru.
//
// Reads bench/airline_schema.json — tau2's openai_schema marshaled to JSON
// by dump_airline_schema.py (transport only: it serializes what tau2
// already hands stock agents and makes no vocabulary decision). Every
// semantic choice lives HERE: the schema-type -> wire-type mapping
// (composites become `string` — JSON text carried "quoted" on the wire;
// a string param named `expression` stays `string` — math text quoted),
// the underscore->hyphen name map, write-vs-read
// costs, doc wording, the register block, the emitted proc plumbing.
//
// name<x> possession types are deliberately NOT emitted — the
// transliterated arm mints no handles; that layer is hand-authored in
// airline_native.kz, where the phantoms ARE the experiment.
//
// Run: ./gen_airline.sh  (dump + koruc + run)
// Output: airline_tools.k + airline_vocab_doc.md — GENERATED files.

~import std/io
~import std/fs
~import koru/yyjson

const std = @import("std");
const yyj = @import("root").koru_koru.koru_yyjson;
const A = std.heap.page_allocator;

// Accumulators — emit-one appends per tool; assemble joins into files.
var tors_out: std.ArrayList(u8) = .{};
var docs_out: std.ArrayList(u8) = .{};
var reg_out: std.ArrayList(u8) = .{};
var tools_n: usize = 0;

fn jstr(v: ?*yyj.Value) []const u8 {
    const p = yyj.c.yyjson_get_str(v) orelse return "";
    return p[0..yyj.c.yyjson_get_len(v)];
}

fn jget(v: ?*yyj.Value, key: []const u8) ?*yyj.Value {
    return yyj.c.yyjson_obj_getn(v, key.ptr, key.len);
}

fn jhas(v: ?*yyj.Value, key: []const u8) bool {
    return jget(v, key) != null;
}

fn put(list: *std.ArrayList(u8), s: []const u8) void {
    list.appendSlice(A, s) catch @panic("gen_airline: OOM");
}

fn putf(list: *std.ArrayList(u8), comptime fmt: []const u8, args: anytype) void {
    const s = std.fmt.allocPrint(A, fmt, args) catch @panic("gen_airline: OOM");
    list.appendSlice(A, s) catch @panic("gen_airline: OOM");
}

fn hyphenate(n: []const u8, buf: []u8) []const u8 {
    if (n.len > buf.len) @panic("gen_airline: tool name exceeds scratch");
    @memcpy(buf[0..n.len], n);
    for (buf[0..n.len]) |*c| {
        if (c.* == '_') c.* = '-';
    }
    return buf[0..n.len];
}

// The wire-type ruling: JSON-schema type -> declared Koru field type.
// Composite params (arrays, objects, $ref/anyOf shapes) are `string` —
// the wire carries them "quoted" as JSON text. A string param named
// `expression` stays `string` — quoted math text. Scalars keep their
// strict types; a bare value must be a Koru expression the evaluator
// judges — bare prose on a `string` field refuses.
const Kind = enum { str, int, num, boolean, source, expr };

fn fieldKind(name: []const u8, prop: *yyj.Value) Kind {
    const t = jstr(jget(prop, "type"));
    const composite = t.len == 0 or std.mem.eql(u8, t, "array") or
        std.mem.eql(u8, t, "object") or jhas(prop, "anyOf") or
        jhas(prop, "$ref");
    if (composite) return .source;
    if (std.mem.eql(u8, t, "string"))
        return if (std.mem.eql(u8, name, "expression")) .expr else .str;
    if (std.mem.eql(u8, t, "integer")) return .int;
    if (std.mem.eql(u8, t, "number")) return .num;
    if (std.mem.eql(u8, t, "boolean")) return .boolean;
    std.debug.print("gen_airline: unmapped schema type '{s}' on param '{s}'\n", .{ t, name });
    @panic("gen_airline: unmapped schema type");
}

fn koruType(k: Kind) []const u8 {
    return switch (k) {
        .str => "string",
        .int => "i64",
        .num => "f64",
        .boolean => "bool",
        .source => "string",
        .expr => "string",
    };
}

fn inRequired(req: ?*yyj.Value, key: []const u8) bool {
    const r = req orelse return false;
    var it: yyj.c.yyjson_arr_iter = undefined;
    if (!yyj.c.yyjson_arr_iter_init(r, &it)) return false;
    while (yyj.c.yyjson_arr_iter_next(&it)) |rv| {
        if (std.mem.eql(u8, jstr(rv), key)) return true;
    }
    return false;
}

// Descriptions can carry their own newlines ("Only transfer if\n -  …").
// The doc is also the `contract` decl's annotation prose, where every line
// is trimmed and a leading `- `/`* `/`+ ` parses as a flag bullet — so
// continuation lines (and any bullet-marked line) re-glyph to `· `, which
// keeps the text prose.
fn putDocText(out: *std.ArrayList(u8), text: []const u8) void {
    var lines = std.mem.splitScalar(u8, std.mem.trim(u8, text, " \n\t"), '\n');
    var first = true;
    while (lines.next()) |raw| {
        var line = std.mem.trim(u8, raw, " \t");
        if (line.len == 0) continue;
        if (line.len > 1 and (line[0] == '-' or line[0] == '*' or line[0] == '+') and (line[1] == ' ' or line[1] == '\t'))
            line = std.mem.trim(u8, line[1..], " \t");
        if (first) {
            put(out, line);
            first = false;
        } else putf(out, "\n· {s}", .{line});
    }
}

// Expand a $ref'd composite into its declared fields — the nested shape the
// stock arm's schema renders, flattened to one line.
fn emitShape(name: []const u8, prop: *yyj.Value, defs: ?*yyj.Value) bool {
    var ref = jstr(jget(prop, "$ref"));
    if (ref.len == 0) {
        const items = jget(prop, "items") orelse return false;
        const anyof = jget(items, "anyOf") orelse return false;
        var it: yyj.c.yyjson_arr_iter = undefined;
        if (!yyj.c.yyjson_arr_iter_init(anyof, &it)) return false;
        while (yyj.c.yyjson_arr_iter_next(&it)) |arm| {
            const r = jstr(jget(arm, "$ref"));
            if (r.len != 0) {
                ref = r;
                break;
            }
        }
    }
    if (!std.mem.startsWith(u8, ref, "#/$defs/")) return false;
    const d = defs orelse return false;
    const shape = jget(d, ref["#/$defs/".len..]) orelse return false;
    const sprops = jget(shape, "properties") orelse return false;
    putf(&docs_out, "· {s}: string — array/object as \"quoted\" JSON text — {{", .{name});
    var oi: yyj.c.yyjson_obj_iter = undefined;
    var first = true;
    if (yyj.c.yyjson_obj_iter_init(sprops, &oi)) {
        while (yyj.c.yyjson_obj_iter_next(&oi)) |kv| {
            const fname = jstr(kv);
            const spec = yyj.c.yyjson_obj_iter_get_val(kv);
            if (!first) put(&docs_out, "; ");
            first = false;
            putf(&docs_out, "{s}: {s}", .{ fname, jstr(jget(spec, "type")) });
            const fdesc = std.mem.trim(u8, jstr(jget(spec, "description")), " \n\t");
            if (fdesc.len != 0) {
                // Inline inside the {…} shape — newlines would break the
                // line, so this projection flattens them to spaces.
                put(&docs_out, " — ");
                for (fdesc) |ch| put(&docs_out, if (ch == '\n' or ch == '\r') " " else &[1]u8{ch});
            }
        }
    }
    put(&docs_out, "}\n");
    return true;
}

const Field = struct { name: []const u8, kind: Kind, prop: *yyj.Value };

// Doctrine append — policy preconditions that must reach the model BEFORE
// the call is chosen, not after it fires. Post-dispatch guides teach the
// next call; this text gates this one. Sourced from the domain's policy
// document; keyed by tool name; domain-general — never task-specific.
fn doctrineFor(name: []const u8) ?[]const u8 {
    if (std.mem.eql(u8, name, "cancel-reservation"))
        return "Cancellation preconditions — the API does NOT check them: cancel only if the booking is within 24h, the airline cancelled the flight, it is business cabin, or travel insurance covers the reason; if any segment already flew, transfer-to-human-agents instead. Obtain the cancellation reason and explicit user confirmation before calling.";
    return null;
}

// One tool -> tor decl + proc + register line + doc block. Every byte of
// the emitted contract is derived from the schema in `v`; the only added
// constants are the name map, the cost rule, and the type mapping above.
fn emitTool(v: *yyj.Value) void {
    const name = jstr(jget(v, "name"));
    const func = jget(v, "function") orelse @panic("gen_airline: tool missing 'function'");
    const write = if (jget(v, "write")) |w| yyj.c.yyjson_is_true(w) else false;
    var nb: [128]u8 = undefined;
    const kname = hyphenate(name, &nb);

    const params = jget(func, "parameters") orelse @panic("gen_airline: schema missing 'parameters'");
    const props = jget(params, "properties") orelse @panic("gen_airline: schema missing 'properties'");
    const req = jget(params, "required");
    const defs = jget(params, "$defs");

    var fields: [32]Field = undefined;
    var nf: usize = 0;
    var oi: yyj.c.yyjson_obj_iter = undefined;
    if (!yyj.c.yyjson_obj_iter_init(props, &oi)) @panic("gen_airline: 'properties' not an object");
    while (yyj.c.yyjson_obj_iter_next(&oi)) |kv| {
        const key = jstr(kv);
        if (std.mem.eql(u8, key, "self")) continue;
        const pv = yyj.c.yyjson_obj_iter_get_val(kv) orelse continue;
        // The wire has no optional params — declaring one required would
        // make the gate STRICTER than the stock arm's schema. Fail loud.
        if (!inRequired(req, key)) {
            std.debug.print("gen_airline: {s}.{s} is optional — the wire cannot declare it\n", .{ name, key });
            @panic("gen_airline: optional param — extend the grammar first");
        }
        fields[nf] = .{ .name = key, .kind = fieldKind(key, pv), .prop = pv };
        nf += 1;
    }

    // tor decl — preceded by a vertical annotation block carrying the
    // schema's `description` as prose, so the vocabulary render can say
    // what the verb IS beside what it takes. Prose collapses to one line:
    // a newline inside the block would split it (each line joins), and a
    // leading bullet marker would become a flag.
    const desc = std.mem.trim(u8, jstr(jget(func, "description")), " \n\t");
    var dbuf: [1024]u8 = undefined;
    var dlen: usize = 0;
    for (desc) |ch| {
        if (dlen >= dbuf.len - 1) break;
        dbuf[dlen] = switch (ch) {
            '\n', '\r', '\t' => ' ',
            '[', ']' => ' ',
            else => ch,
        };
        dlen += 1;
    }
    // Doctrine append rides the same doc annotation — same sanitization
    // (one line, no bracket bytes) so it survives every emit site.
    if (doctrineFor(kname)) |note| {
        if (dlen > 0 and dlen < dbuf.len - 1) {
            dbuf[dlen] = ' ';
            dlen += 1;
        }
        for (note) |ch| {
            if (dlen >= dbuf.len - 1) break;
            dbuf[dlen] = switch (ch) {
                '\n', '\r', '\t' => ' ',
                '[', ']' => ' ',
                else => ch,
            };
            dlen += 1;
        }
    }
    // Every tool tor declares two outcomes: `ok` for a dispatched result,
    // `error` for tau2's raised failure (the marshal forwards the env's
    // error flag). An error can never bind inside an `ok` arm — an unarmed
    // `error` outcome stops the reply as unhandled-branch, and a model that
    // wants to act on a failure must write `| error e |>` on purpose.
    if (nf == 0) {
        putf(&tors_out, "[\n- doc\n{s}\n]\npub tor {s} {{}}\n| ok string\n| error string\n\n", .{ dbuf[0..dlen], kname });
    } else {
        putf(&tors_out, "[\n- doc\n{s}\n]\npub tor {s} {{ ", .{ dbuf[0..dlen], kname });
        for (fields[0..nf], 0..) |f, i| {
            if (i != 0) put(&tors_out, ", ");
            putf(&tors_out, "{s}: {s}", .{ f.name, koruType(f.kind) });
        }
        put(&tors_out, " }\n| ok string\n| error string\n\n");
    }

    // proc — serializes inputs to the tau2 JSON args object, emits the
    // outbound CALL line under this tor's own tau2 name, blocks for the
    // result. JSON-text fields splice the quoted payload through
    // __jsonKeys — bare record keys still normalize to JSON if the model
    // writes them, so the wire stays Koru-shaped.
    putf(&tors_out, "proc {s}|zig {{\n    const __W = @import(\"root\").koru_app.koru_tau_wire;\n", .{kname});
    if (nf == 0) {
        putf(&tors_out, "    const __r = __W.callIO(\"{s}\", \"{{}}\");\n    if (__r.err) return .{{ .error = __r.content }};\n    return .{{ .ok = __r.content }};\n}}\n\n", .{name});
    } else {
        var buf: usize = 1024;
        for (fields[0..nf]) |f| {
            if (f.kind == .source) buf = 4096;
        }
        if (nf > 4 and buf < 2048) buf = 2048;
        putf(&tors_out, "    const std = @import(\"std\");\n    const __S = struct {{ threadlocal var buf: [{d}]u8 = undefined; }};\n", .{buf});
        var fmtbuf: std.ArrayList(u8) = .{};
        var argbuf: std.ArrayList(u8) = .{};
        var ei: usize = 0;
        var ki: usize = 0;
        for (fields[0..nf], 0..) |f, i| {
            if (i != 0) {
                put(&fmtbuf, ", ");
                put(&argbuf, ", ");
            }
            switch (f.kind) {
                // Quoted params go through __jsonEsc — a raw splice writes
                // a runtime newline/quote into the JSON unescaped and the
                // marshal's inner parse fails (measured 2026-09-27: say()
                // with \n\n in text marshalled to an empty user message).
                .str, .expr => {
                    putf(&tors_out, "    var __e{d}: [{d}]u8 = undefined;\n    const {s}_v = __W.jsonEsc({s}, &__e{d});\n", .{ ei, buf, f.name, f.name, ei });
                    ei += 1;
                    putf(&fmtbuf, "\\\"{s}\\\": \\\"{{s}}\\\"", .{f.name});
                    putf(&argbuf, "{s}_v", .{f.name});
                },
                .source => {
                    putf(&tors_out, "    var __k{d}: [{d}]u8 = undefined;\n    const {s}_v = __W.jsonKeys({s}, &__k{d});\n", .{ ki, buf, f.name, f.name, ki });
                    ki += 1;
                    putf(&fmtbuf, "\\\"{s}\\\": {{s}}", .{f.name});
                    putf(&argbuf, "{s}_v", .{f.name});
                },
                else => {
                    putf(&fmtbuf, "\\\"{s}\\\": {{{s}}}", .{ f.name, if (f.kind == .boolean) "s" else "d" });
                    putf(&argbuf, "{s}", .{f.name});
                },
            }
        }
        putf(&tors_out, "    const __args = std.fmt.bufPrint(&__S.buf,\n        \"{{{{{s}}}}}\",\n        .{{ {s} }}) catch @panic(\"kopium: {s} args exceed scratch\");\n    const __r = __W.callIO(\"{s}\", __args);\n    if (__r.err) return .{{ .error = __r.content }};\n    return .{{ .ok = __r.content }};\n}}\n\n", .{ fmtbuf.items, argbuf.items, name, name });
    }

    // register line — WRITE tools cost more (commitment vs read).
    putf(&reg_out, "    {s}({d})\n", .{ kname, if (write) @as(u8, 10) else 1 });

    // doc block — derived from schema; declared wire types shown for the
    // JSON-text fields (string), schema types for scalars. Field lines lead
    // with `· ` and descriptions run through putDocText: the same text lands
    // on the `contract` decl as annotation prose, where leading whitespace
    // is trimmed and bullet markers would parse as flags.
    putf(&docs_out, "{s} — ", .{kname});
    putDocText(&docs_out, desc);
    put(&docs_out, "\n");
    for (fields[0..nf]) |f| {
        switch (f.kind) {
            .source => {
                if (!emitShape(f.name, f.prop, defs)) {
                    const t = jstr(jget(f.prop, "type"));
                    putf(&docs_out, "· {s}: string — JSON {s}, \"quoted\"", .{ f.name, if (t.len != 0) t else "value" });
                    const pd = std.mem.trim(u8, jstr(jget(f.prop, "description")), " \n\t");
                    if (pd.len != 0) { put(&docs_out, " — "); putDocText(&docs_out, pd); }
                    put(&docs_out, "\n");
                }
            },
            .expr => {
                putf(&docs_out, "· {s}: string — math/expression text, \"quoted\"", .{f.name});
                const pd = std.mem.trim(u8, jstr(jget(f.prop, "description")), " \n\t");
                if (pd.len != 0) { put(&docs_out, " — "); putDocText(&docs_out, pd); }
                put(&docs_out, "\n");
            },
            else => {
                putf(&docs_out, "· {s}: {s}", .{ f.name, jstr(jget(f.prop, "type")) });
                const en = jget(f.prop, "enum");
                if (en != null) {
                    put(&docs_out, " — one of ");
                    var eit: yyj.c.yyjson_arr_iter = undefined;
                    var efirst = true;
                    if (yyj.c.yyjson_arr_iter_init(en, &eit)) {
                        while (yyj.c.yyjson_arr_iter_next(&eit)) |ev| {
                            if (!efirst) put(&docs_out, " | ");
                            efirst = false;
                            put(&docs_out, jstr(ev));
                        }
                    }
                }
                const pd = std.mem.trim(u8, jstr(jget(f.prop, "description")), " \n\t");
                if (pd.len != 0) { put(&docs_out, " — "); putDocText(&docs_out, pd); }
                put(&docs_out, "\n");
            },
        }
    }
    put(&docs_out, "\n");
}

~pub tor emit-one { v: *koru/yyjson:Value }

~proc emit-one|zig {
    emitTool(v);
    tools_n += 1;
}

// Assemble the two output files from the accumulators — the file header,
// the voice channel, the per-tool text, and the register block.
~pub tor assemble {} -> { kz: string, doc: string, n: i64 }

~proc assemble|zig {
    var doc_final: std.ArrayList(u8) = .{};
    put(&doc_final, DOC_PREAMBLE);
    put(&doc_final, docs_out.items);
    var kz_final: std.ArrayList(u8) = .{};
    put(&kz_final, GENERATED_HEADER);
    put(&kz_final, SAY_TOR);
    put(&kz_final, tors_out.items);
    // The tool contract is the scope's documentation, never a verb:
    // `contract` is declared with the whole doc as its annotation prose but
    // never registered — `register` lifts the prose into the scope manifest
    // and the grammar render serves it, so the field shapes ride the system
    // message instead of costing a model turn to fetch. Same text as
    // airline_vocab_doc.md — doc_final is emitted already prose-canonical
    // (trimmed lines, `·` sub-items, no bullet-marker starts), and the two
    // panics guard the block's own delimiters.
    put(&kz_final, "// The tool contract — scope documentation, not a call.\n// Same text as airline_vocab_doc.md.\n\n[\n- doc\n");
    var lines = std.mem.splitScalar(u8, doc_final.items, '\n');
    while (lines.next()) |line| {
        if (line.len == 0 and lines.peek() == null) break;
        const t = std.mem.trim(u8, line, " \t");
        if (t.len > 0 and t[0] == ']')
            @panic("gen_airline: doc line would close the annotation block");
        if (t.len > 1 and (t[0] == '-' or t[0] == '*' or t[0] == '+') and (t[1] == ' ' or t[1] == '\t'))
            @panic("gen_airline: doc line would parse as a flag bullet, not prose");
        putf(&kz_final, "{s}\n", .{line});
    }
    put(&kz_final, "]\npub tor contract {} -> string\n\n");
    put(&kz_final, "std/runtime:register(scope: \"airline\") {\n    say(1)\n");
    put(&kz_final, reg_out.items);
    put(&kz_final, "}\n");
    return .{ .kz = kz_final.items, .doc = doc_final.items, .n = @intCast(tools_n) };
}

const GENERATED_HEADER =
    \\// airline_tools.k — GENERATED by bench/gen_airline.kz from tau2's
    \\// openai_schema (marshaled to bench/airline_schema.json by
    \\// bench/dump_airline_schema.py — transport only, no decisions).
    \\// Do not hand-edit: the gate's declared surface is the stock arm's
    \\// schema read by construction; drift is a generator bug, not a
    \\// transcription to fix. Regenerate: ./gen_airline.sh
    \\//
    \\// Field types are type-directed: scalars map straight (integer ->
    \\// i64, number -> f64, boolean -> bool); composite params are
    \\// `string` — JSON text carried "quoted" on the wire
    \\// (flights: \"[{...}]\"); a string param named `expression`
    \\// is `string` — math text quoted. JSON-text fields splice
    \\// through __W.jsonKeys (bare record keys -> quoted) into the
    \\// args JSON so real arrays reach tau2's typed executor.
    \\//
    \\// Each proc IS the southbound effect: it emits the outbound CALL
    \\// line with its own tau2 schema name baked in and blocks on stdin
    \\// for the matching result. Every tor declares two outcomes —
    \\// `| ok string | error string` — and the proc classifies the
    \\// result on tau2's error flag, so a raised failure binds under
    \\// `error`, never inside an ok payload (auto-bound r{N} either way).
    \\// The wire protocol itself lives in
    \\// app/tau_wire — the JSON splice helpers (jsonEsc/jsonKeys) too;
    \\// this file is pure Koru constructs and carries no host lines.
    \\
    \\import std/runtime
    \\import app/tau_wire
    \\
    \\
;

// The voice channel is ours, not tau2's — every domain's refusal surface.
// `text` is string: prose to the user goes in "quotes" like every field.
const SAY_TOR =
    \\// ============================================================================
    \\// THE VOICE CHANNEL — the refusal surface (Koru's own, not a tau2 tool)
    \\// ============================================================================
    \\
    \\[
    \\- doc
    \\Delivers text to the user — the only verb they can hear. Owes them a reply.
    \\]
    \\pub tor say { text: string } -> string
    \\
    \\proc say|zig {
    \\    return @import("root").koru_app.koru_tau_wire.sayIO(text);
    \\}
    \\
    \\
;

// The doc carries the tool contract only — introspection host verbs are
// named by the grammar's preamble, so the two can never drift.
const DOC_PREAMBLE =
    \\# Tool contract — generated from the declared schema
    \\
    \\Every entry below is translated verbatim from the tool schema the
    \\stock interface advertises (descriptions, types, enums, nested field
    \\shapes). Composite and math fields are `string` — carry the payload
    \\as "quoted" JSON/expression text, escaping inner quotes
    \\(`flights: \"[{...}]\"`, `calculate(expression: \"2 + 2\")`). Scalar
    \\strings need "double quotes" too; bare values are Koru expressions.
    \\
    \\say(text: string) — the voice channel: what the user hears. Always
    \\"quoted" — {{ }} inside splices bound values into the line.
    \\
    \\Every tool answers one of two outcomes: `ok` carries the result
    \\payload; `error` carries the failure text ("not found", "not enough
    \\seats", ...). `call(...) | ok r |>` arms success only — an error
    \\that fires unarmed stops the reply right there (unhandled-branch,
    \\nothing else in the program runs). To act on a failure, arm it:
    \\`| error e |> say(text: "...")` and read `e` for the reason.
    \\
    \\
;

// Drive: schema in, two files out.
~std/io:read-file(path: "airline_schema.json")
| ok content |> koru/yyjson:parse(text: content)
    | ok doc |> koru/yyjson:root(doc): root_v
        |> koru/yyjson:object.get(doc, v: root_v, key: "tools")
        | found tools_v |> koru/yyjson:array.each(doc, v: tools_v)
            ! item tv |> emit-one(v: tv)
            | done |> assemble(): outs
                |> koru/yyjson:close(doc)
                |> std/io:free(content)
                |> std/fs:write-file(path: "airline_tools.k", content: outs.kz)
                | written |> std/fs:write-file(path: "airline_vocab_doc.md", content: outs.doc)
                    | written |> std/io:eprint.ln("gen_airline: {{ outs.n:d }} tors + say -> airline_tools.k + airline_vocab_doc.md")
                    | failed m |> std/io:eprint.ln("gen_airline: doc write failed {{ m:s }}")
                | failed m |> std/io:eprint.ln("gen_airline: tools write failed {{ m:s }}")
            | not-an-array |> koru/yyjson:close(doc) |> std/io:free(content) |> std/io:eprint.ln("gen_airline: 'tools' not an array")
        | not-found |> koru/yyjson:close(doc) |> std/io:free(content) |> std/io:eprint.ln("gen_airline: schema has no 'tools'")
    | err e |> std/io:free(content) |> std/io:eprint.ln("gen_airline: schema parse failed {{ e.msg:s }}")
| not-found |> std/io:eprint.ln("gen_airline: airline_schema.json missing — run dump_airline_schema.py")
| failed m |> std/io:eprint.ln("gen_airline: schema read failed {{ m:s }}")
