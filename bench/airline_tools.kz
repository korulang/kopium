~pub tor say { text: Source } -> string

~proc say|zig {
    return @import("root").koru_app.koru_tau_wire.sayIO(text.text);
}

~pub tor book-reservation { user_id: string, origin: string, destination: string, flight_type: string, cabin: string, flights: Source, passengers: Source, payment_methods: Source, total_baggages: i64, nonfree_baggages: i64, insurance: string } -> string

~proc book-reservation|zig {
    const __W = @import("root").koru_app.koru_tau_wire;
    const __S = struct { threadlocal var buf: [4096]u8 = undefined; };
    var __e0: [4096]u8 = undefined;
    const user_id_v = __jsonEsc(user_id, &__e0);
    var __e1: [4096]u8 = undefined;
    const origin_v = __jsonEsc(origin, &__e1);
    var __e2: [4096]u8 = undefined;
    const destination_v = __jsonEsc(destination, &__e2);
    var __e3: [4096]u8 = undefined;
    const flight_type_v = __jsonEsc(flight_type, &__e3);
    var __e4: [4096]u8 = undefined;
    const cabin_v = __jsonEsc(cabin, &__e4);
    var __k0: [4096]u8 = undefined;
    const flights_v = __jsonKeys(flights.text, &__k0);
    var __k1: [4096]u8 = undefined;
    const passengers_v = __jsonKeys(passengers.text, &__k1);
    var __k2: [4096]u8 = undefined;
    const payment_methods_v = __jsonKeys(payment_methods.text, &__k2);
    var __e5: [4096]u8 = undefined;
    const insurance_v = __jsonEsc(insurance, &__e5);
    const __args = std.fmt.bufPrint(&__S.buf,
        "{{\"user_id\": \"{s}\", \"origin\": \"{s}\", \"destination\": \"{s}\", \"flight_type\": \"{s}\", \"cabin\": \"{s}\", \"flights\": {s}, \"passengers\": {s}, \"payment_methods\": {s}, \"total_baggages\": {d}, \"nonfree_baggages\": {d}, \"insurance\": \"{s}\"}}",
        .{ user_id_v, origin_v, destination_v, flight_type_v, cabin_v, flights_v, passengers_v, payment_methods_v, total_baggages, nonfree_baggages, insurance_v }) catch @panic("kopium: book_reservation args exceed scratch");
    return __W.callIO("book_reservation", __args);
}

