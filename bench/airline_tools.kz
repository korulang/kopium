// airline-scope.kz — the τ³ airline domain's FULL tool surface, as a Koru
// register block. Every tor the harness exposes (from tools.py) is declared
// here: the reads, the writes, the generic helper, and the voice channel.
//
// Structured τ³ arguments (flights: List[FlightInfo], passengers: List[...],
// payment_methods: [...]) ride inside Koru STRING params as JSON. The register
// block vets the verb and the flat scalars; Python materializes the JSON into
// τ³'s typed payloads — full type-carrying grammar is the R2 rung.
//
// Every tor returns its OWN PARSED INPUTS as a JSON string, so the gate's OK
// line carries arguments WITHOUT Python re-parsing Koru: the interpreter
// parses the invocation, hands each field to this proc, and the proc
// serializes what it received. Procs do NOT perform the tool's effect — τ³
// executes the real tools on its DB — but the boundary between "what the
// model said" and "what the harness runs" is exactly this serialization.

~import std/runtime

const std = @import("std");

// ============================================================================
// THE VOICE CHANNEL — the refusal surface
// ============================================================================

~pub tor say { text: string } -> string

~proc say|zig {
    var buf: [2048]u8 = undefined;
    const s = std.fmt.bufPrint(&buf, "{{\"text\": \"{s}\"}}", .{text}) catch "{}";
    return s;
}

