// ============================================================================
// WRITES (the policy-guarded verbs)
// ============================================================================

~pub tor book-reservation {
    user_id: string,
    origin: string,
    destination: string,
    flight_type: string,
    cabin: string,
    flights: string,
    passengers: string,
    payment_methods: string,
    total_baggages: string,
    nonfree_baggages: string,
    insurance: string,
} -> string

~proc book-reservation|zig {
    var buf: [4096]u8 = undefined;
    const s = std.fmt.bufPrint(&buf,
        "{{\"user_id\": \"{s}\", \"origin\": \"{s}\", \"destination\": \"{s}\", \"flight_type\": \"{s}\", \"cabin\": \"{s}\", \"flights\": {s}, \"passengers\": {s}, \"payment_methods\": {s}, \"total_baggages\": {s}, \"nonfree_baggages\": {s}, \"insurance\": {s}}}",
        .{ user_id, origin, destination, flight_type, cabin, flights, passengers, payment_methods, total_baggages, nonfree_baggages, insurance }) catch "{}";
    return s;
}

~pub tor cancel-reservation { reservation_id: string } -> string

~proc cancel-reservation|zig {
    var buf: [1024]u8 = undefined;
    const s = std.fmt.bufPrint(&buf, "{{\"reservation_id\": \"{s}\"}}", .{reservation_id}) catch "{}";
    return s;
}

