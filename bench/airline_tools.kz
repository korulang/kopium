// ============================================================================
// HELPER
// ============================================================================

~pub tor calculate { expression: string } -> string

~proc calculate|zig {
    var buf: [1024]u8 = undefined;
    const s = std.fmt.bufPrint(&buf, "{{\"expression\": \"{s}\"}}", .{expression}) catch "{}";
    return s;
}

// ============================================================================
// THE PERMISSION MODEL — everything the agent may call, nothing else
// ============================================================================

~std/runtime:register(scope: "airline") {
    say(1)
    get-user-details(1)
    get-reservation-details(1)
    list-all-airports(1)
    search-direct-flight(1)
    search-onestop-flight(1)
    get-flight-status(1)
    book-reservation(10)
    cancel-reservation(10)
    send-certificate(1)
    update-reservation-flights(10)
    update-reservation-passengers(10)
    update-reservation-baggages(10)
    transfer-to-human-agents(1)
    calculate(1)
}