// A wire turn is one flow (frag-partial-programs): the caller writes the
// whole reply — possibly several items, one per line — terminated by a
// blank line, and `run` segments it into items. `intake` therefore reads
// until a blank line for every first line; there is no command channel —
// introspection is a wire verb (`vocabulary()`, `grammar()`), granted per
// session, and anything else reaching `run` is the wire's own parse-error
// to refuse. readln's buffer dies on the next read, so we copy before the
// continuation lines.

const std = @import("std");

var intake_buf: [8192]u8 = undefined;

~pub tor intake { first: string }
| ready string
| incomplete
| failed string

~proc intake|zig {
    const t = std.mem.trim(u8, first, " \t\r");
    if (t.len == 0) {
        return .{ .ready = first };
    }
    if (first.len + 1 >= $mod.intake_buf.len) {
        return .{ .failed = "turn too long" };
    }
    @memcpy($mod.intake_buf[0..first.len], first);
    var i: usize = first.len;
    $mod.intake_buf[i] = '\n';
    i += 1;
    const stdin = std.fs.File.stdin();
    var line_start = i;
    // String-aware framing (same state machine as bridge.turnscan): a
    // blank line inside a "..." string is content, not the turn
    // terminator. `first` is one whole line, so its backtick state
    // does not carry; in_string does — strings span lines.
    var quote: u8 = 0;
    var in_backtick = false;
    var escaped = false;
    var k: usize = 0;
    while (k < first.len) {
        const c = first[k];
        if (escaped) {
            escaped = false;
        } else {
            if (quote != 0) {
                if (c == '\\') {
                    escaped = true;
                }
                if (c == quote) {
                    quote = 0;
                }
            } else {
                if (c == '`') {
                    in_backtick = !in_backtick;
                }
                if (!in_backtick and c == '"') {
                    quote = c;
                }
            }
        }
        k += 1;
    }
    in_backtick = false;
    while (i < $mod.intake_buf.len) {
        var b: [1]u8 = undefined;
        const n = stdin.read(b[0..]) catch return .{ .failed = "Failed to read stdin" };
        if (n == 0) break;
        const c = b[0];
        if (escaped) {
            escaped = false;
        } else {
            if (quote != 0) {
                if (c == '\\') {
                    escaped = true;
                }
                if (c == quote) {
                    quote = 0;
                }
            } else {
                if (c == '`') {
                    in_backtick = !in_backtick;
                }
                if (!in_backtick and c == '"') {
                    quote = c;
                }
            }
        }
        if (c == '\n') {
            var end = i;
            if (end > line_start and $mod.intake_buf[end - 1] == '\r') end -= 1;
            if (end == line_start and quote == 0) break;
            $mod.intake_buf[i] = '\n';
            i += 1;
            line_start = i;
            in_backtick = false;
            continue;
        }
        $mod.intake_buf[i] = c;
        i += 1;
    }
    if (i == $mod.intake_buf.len) return .{ .failed = "line too long" };
    return .{ .ready = $mod.intake_buf[0..i] };
}

~pub tor emit-framed { tag: string, text: string }

~proc emit-framed|zig {
    const stdout = std.fs.File.stdout();
    stdout.writeAll(tag) catch return;
    stdout.writeAll("-BEGIN\n") catch return;
    stdout.writeAll(text) catch return;
    if (text.len == 0 or text[text.len - 1] != '\n') {
        stdout.writeAll("\n") catch return;
    }
    stdout.writeAll(tag) catch return;
    stdout.writeAll("-END\n") catch return;
}

// Same framing, silent on empty — the CALLSTEPS block exists only on
// turns that dispatched, so an empty drain must not print a frame the
// session parser would have to special-case.
~pub tor emit-framed-nonempty { tag: string, text: string }

~proc emit-framed-nonempty|zig {
    if (text.len == 0) return;
    const stdout = std.fs.File.stdout();
    stdout.writeAll(tag) catch return;
    stdout.writeAll("-BEGIN\n") catch return;
    stdout.writeAll(text) catch return;
    if (text[text.len - 1] != '\n') {
        stdout.writeAll("\n") catch return;
    }
    stdout.writeAll(tag) catch return;
    stdout.writeAll("-END\n") catch return;
}
