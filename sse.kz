// kopium — SSE line framing over curl's `! chunk` byte stream.
//
// `text/event-stream` frames records as lines; a TCP chunk can end mid-line,
// so framing needs state that survives between `! chunk` firings. That state
// lives here, module-level, and `feed` is the whole surface: hand it each
// chunk's bytes and it fires `! data` once per complete `data: ` line —
// already stripped of the field prefix, with the protocol's own plumbing
// (comment keepalives, blank separators, the `[DONE]` sentinel some
// OpenAI-shaped providers send) consumed silently, because those are the
// wire format's punctuation, not content.
//
// FINDING (kopium charter: the wall is the deliverable): this module exists
// because SSE framing has no home in koru-libs yet. It is app-local zig by
// the same necessity as gitgazer's a_git_lines.kz (no std/process) — the
// natural home is a curl sibling (`koru/sse`) or the reborn ai package, and
// this file is the spec for it.

const std = @import("std");

var sse_buf: [262144]u8 = undefined;
var sse_len: usize = 0;

~pub tor feed { bytes: string }
! data string
| ok
| overflow

~proc feed|zig {
    if ($mod.sse_len + bytes.len > $mod.sse_buf.len) return .{ .overflow = .{} };
    @memcpy($mod.sse_buf[$mod.sse_len..][0..bytes.len], bytes);
    $mod.sse_len += bytes.len;

    var start: usize = 0;
    while (std.mem.indexOfScalarPos(u8, $mod.sse_buf[0..$mod.sse_len], start, '\n')) |nl| {
        var line_bytes = $mod.sse_buf[start..nl];
        start = nl + 1;
        if (line_bytes.len > 0 and line_bytes[line_bytes.len - 1] == '\r') {
            line_bytes = line_bytes[0 .. line_bytes.len - 1];
        }
        if (!std.mem.startsWith(u8, line_bytes, "data: ")) continue;
        const payload = line_bytes["data: ".len..];
        if (std.mem.eql(u8, payload, "[DONE]")) continue;
        data(payload);
    }

    std.mem.copyForwards(u8, $mod.sse_buf[0..], $mod.sse_buf[start..$mod.sse_len]);
    $mod.sse_len -= start;
    return .{ .ok = .{} };
}

// "Bearer {key}" — the key is a borrow into a yyjson doc the caller is
// about to close, so this COPIES. FINDING: string concatenation in koru
// today is either std/string's instance machinery or this — a one-line
// allocPrint tor. The ergonomic gap is real; std/string:format is the
// missing tor.
~pub tor bearer { key: string } -> string

~proc bearer|zig {
    return std.fmt.allocPrint(std.heap.page_allocator, "Bearer {s}", .{key}) catch @panic("kopium: OOM building auth header");
}
