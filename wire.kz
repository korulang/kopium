// kopium-headless — the transport, so `live.k` can stay about the bridge.
//
// Lifted from `kopium/auth.kz` (bearer / remember / recall, unchanged) and
// grown two things the headless agent needs: a prompt that hands the model
// its vocabulary, and a place to accumulate a streamed reply.
//
// The reply buffer is module-held Zig state, and that is a considered choice
// rather than a shortcut. The alternative is a store-held String, which is
// what `d_turns.k` uses — but reading it back out means a tor param inside a
// SWEEP arm to reach `std/bridge:run`, which is the shape `690_234` pins as
// uncaptured. `auth.kz` already made this exact call for `recall` and wrote
// down why. Same reason, same shape.
//
// Note what this file does NOT need: the delta text is appended HERE, inside
// the arm that still owns the yyjson doc, so nothing escapes an arena and
// holes/3 never fires. That hole bites the RETURN, not the extraction.

const std = @import("std");

// ============================================================================
// AUTH — identical to kopium/auth.kz
// ============================================================================

~pub tor bearer { key: string } -> string

~proc bearer|zig {
    return std.fmt.allocPrint(std.heap.page_allocator, "Bearer {s}", .{key}) catch @panic("kopium: OOM building auth header");
}

var auth_buf: [512]u8 = undefined;
var auth_len: usize = 0;

~pub tor remember { auth: string }

~proc remember|zig {
    if (auth.len > $mod.auth_buf.len) @panic("kopium: bearer too long");
    @memcpy($mod.auth_buf[0..auth.len], auth);
    $mod.auth_len = auth.len;
}

~pub tor recall {} -> string

~proc recall|zig {
    return $mod.auth_buf[0..$mod.auth_len];
}

// ============================================================================
// THE REPLY BUFFER — one turn's worth of streamed deltas
// ============================================================================

var reply_buf: [4096]u8 = undefined;
var reply_len: usize = 0;

~pub tor reset {}

~proc reset|zig {
    $mod.reply_len = 0;
}

// Called from inside the delta arm, while the doc is still open.
~pub tor collect { text: string }

~proc collect|zig {
    const room = $mod.reply_buf.len - $mod.reply_len;
    const n = @min(room, text.len);
    @memcpy($mod.reply_buf[$mod.reply_len..][0..n], text[0..n]);
    $mod.reply_len += n;
}

// The accumulated reply, with surrounding whitespace and any markdown fence
// stripped — a chat model wraps code in ``` about half the time, and the
// interpreter is owed source, not a transcript of one.
~pub tor reply {} -> string

~proc reply|zig {
    var s = std.mem.trim(u8, $mod.reply_buf[0..$mod.reply_len], " \t\r\n");

    if (std.mem.startsWith(u8, s, "```")) {
        // drop the opening fence and its optional language tag
        const nl = std.mem.indexOfScalar(u8, s, '\n') orelse s.len;
        s = s[@min(nl + 1, s.len)..];
        if (std.mem.lastIndexOf(u8, s, "```")) |end| s = s[0..end];
        s = std.mem.trim(u8, s, " \t\r\n");
    }

    // One invocation per turn: if the model volunteered prose after it, keep
    // the first line. A tool call is a line, and this is the cheapest way to
    // be strict about that without pretending to parse Koru here.
    if (std.mem.indexOfScalar(u8, s, '\n')) |nl| s = std.mem.trim(u8, s[0..nl], " \t\r");

    return s;
}

// ============================================================================
// THE PROMPT — the vocabulary is the `register` block, restated for the model
// ============================================================================
//
// FINDING, and it is the interesting one: this restatement is DUPLICATION.
// `notes.kz` already declares the agent's whole vocabulary in a form the
// compiler reads, and the model needs the same facts in English. Deriving
// this text from the scope declaration is the obvious next move and there is
// no surface for it today — `std/runtime:collect-scopes` walks the AST at
// compile time, but nothing exposes a scope's events and their argument names
// to a running program. Until then the two can drift, and the only thing that
// catches the drift is `event-denied` at runtime.

// The conversation so far, already JSON-escaped and comma-prefixed, ready to
// splice between the system message and the current goal.
//
// `d_turns.k` cuts this scope explicitly — "each send carries only the newest
// message" — and pays for it: a bridge that holds resources ACROSS turns
// paired with a model that remembers nothing produces an agent which reopens
// what it already has. Measured here on the first live run: turn 2 answered
// "I haven't opened a note yet, so I need to open one first:" and was refused
// as not-Koru. The resource was live on the bridge at that moment.
var hist_buf: [16384]u8 = undefined;
var hist_len: usize = 0;

// NOTE: no `$mod.` in here. That substitution happens inside `~proc` bodies
// only; in a plain host-line `fn` the token survives verbatim into the emitted
// Zig and lands as "expected expression, found invalid token". Container-level
// vars are reachable by bare name from a fn in the same container anyway.
fn histAppend(bytes: []const u8) void {
    const room = hist_buf.len - hist_len;
    if (bytes.len > room) return; // oldest-wins: a full history stops growing
    @memcpy(hist_buf[hist_len..][0..bytes.len], bytes);
    hist_len += bytes.len;
}

fn histMessage(alloc: std.mem.Allocator, role: []const u8, content: []const u8) void {
    var msg = std.ArrayListUnmanaged(u8){};
    defer msg.deinit(alloc);
    msg.appendSlice(alloc, ",{\"role\":\"") catch return;
    msg.appendSlice(alloc, role) catch return;
    msg.appendSlice(alloc, "\",\"content\":\"") catch return;
    jsonEscape(alloc, &msg, content);
    msg.appendSlice(alloc, "\"}") catch return;
    histAppend(msg.items);
}

// What the agent was asked, and what it said back. Called once per turn, so
// the next turn sees its own prior invocation and can reason from it — the
// prompt states that the first handle is note_0, which is only actionable if
// the model can see that it already called `open`.
~pub tor remember-turn { goal: string, said: string }

~proc remember-turn|zig {
    const alloc = std.heap.page_allocator;
    histMessage(alloc, "user", goal);
    histMessage(alloc, "assistant", said);
}

~pub tor agent-body { goal: string } -> string

~proc agent-body|zig {
    const alloc = std.heap.page_allocator;

    const system =
        \\You are driving a Koru interpreter. Your ONLY way to act is to emit exactly one Koru invocation.
        \\
        \\Your vocabulary is exactly these three events:
        \\  open(path: "<filename>")            opens a note, returns a handle named note_N
        \\  append(handle: "<handle>", text: "<text>")   writes text into an open note
        \\  close(handle: "<handle>")           closes a note
        \\
        \\Rules:
        \\- Reply with ONE invocation and nothing else. No prose, no markdown, no backticks.
        \\- Arguments are name: value pairs, values are double-quoted strings.
        \\- Do NOT write a leading ~ . That character is not legal here.
        \\- Handles are issued by open(). The first is note_0. Handles you opened in
        \\  earlier turns are STILL OPEN — this session outlives each turn, so never
        \\  reopen something you already opened.
        \\
        \\Examples of well-formed replies:
        \\open(path: "notes.txt")
        \\append(handle: "note_0", text: "hello")
        \\close(handle: "note_0")
    ;

    var out = std.ArrayListUnmanaged(u8){};
    out.appendSlice(alloc, "{\"model\":\"anthropic/claude-haiku-4.5\",\"stream\":true,\"max_tokens\":100,\"messages\":[{\"role\":\"system\",\"content\":\"") catch @panic("kopium: OOM");
    jsonEscape(alloc, &out, system);
    out.appendSlice(alloc, "\"}") catch @panic("kopium: OOM");
    out.appendSlice(alloc, $mod.hist_buf[0..$mod.hist_len]) catch @panic("kopium: OOM");
    out.appendSlice(alloc, ",{\"role\":\"user\",\"content\":\"") catch @panic("kopium: OOM");
    jsonEscape(alloc, &out, goal);
    out.appendSlice(alloc, "\"}]}") catch @panic("kopium: OOM");
    return out.toOwnedSlice(alloc) catch @panic("kopium: OOM");
}

fn jsonEscape(alloc: std.mem.Allocator, out: *std.ArrayListUnmanaged(u8), text: []const u8) void {
    for (text) |ch| {
        switch (ch) {
            '"' => out.appendSlice(alloc, "\\\"") catch @panic("kopium: OOM"),
            '\\' => out.appendSlice(alloc, "\\\\") catch @panic("kopium: OOM"),
            '\n' => out.appendSlice(alloc, "\\n") catch @panic("kopium: OOM"),
            '\t' => out.appendSlice(alloc, "\\t") catch @panic("kopium: OOM"),
            else => {
                if (ch >= 0x20) out.append(alloc, ch) catch @panic("kopium: OOM");
            },
        }
    }
}
