// kopium-headless — the transport, so `live.k` can stay about the bridge.
//
// WHAT LIVES WHERE, and it is a rule rather than a habit: **session state
// lives in the store; a startup constant does not.** The transcript and the
// in-flight reply both change every turn and are the session — they are
// store-held Strings in `live.k`. The bearer token is read once before the
// first turn and never again; it is module state, and that is the whole
// honest reason.
//
// This file previously held the transcript in a `[16384]u8` module buffer and
// justified it with "a tor param inside a SWEEP arm would be 690_234". That
// was WRONG WHEN WRITTEN. 690_234 landed 2026-08-03 and is MUST_RUN green; the
// justification was copied from `wired/auth.kz`, where it had been true, and
// never rechecked. `probe_store.k` settles it directly: a tor whose parameter
// is the bridge reads a store-held String in a sweep arm and dispatches it.
//
// The hand-rolled version was also strictly worse than the store. It was a
// fixed 16 KiB with oldest-wins-stops-growing, so a long enough conversation
// would silently stop recording; a store-held String grows.
//
// The DELTA path needs nothing from holes/3: `live.k` appends each delta
// inside the arm that still owns the yyjson doc, so no borrow escapes an
// arena. The REPLY path did need it, and now uses it — `clean` below returns
// an owned String rather than a sub-slice of its input, which is holes/3's
// workaround shape applied to 610_007's own example.

~import std/string
~import std/runtime
~import std/bridge

const std = @import("std");

// ============================================================================
// AUTH — read once at startup, never again. Not session state.
// ============================================================================

~pub tor bearer { key: string } -> string

~proc bearer|zig {
    return std.fmt.allocPrint(std.heap.page_allocator, "Bearer {s}", .{key}) catch @panic("kopium: OOM building auth header");
}

var auth_buf: [512]u8 = undefined;
var auth_len: usize = 0;

~pub tor remember { auth: string }

~proc remember|zig {
    if (auth.len > $mod.auth_buf.len) @panic("kopium: bearer too long");
    @memcpy($mod.auth_buf[0..auth.len], auth);
    $mod.auth_len = auth.len;
}

~pub tor recall {} -> string

~proc recall|zig {
    return $mod.auth_buf[0..$mod.auth_len];
}

// ============================================================================
// REPLY CLEANUP — pure, no state
// ============================================================================

// The accumulated reply, with surrounding whitespace and any markdown fence
// stripped, reduced to its head: one invocation — or, when the reply opens
// with `tor `, the two lines of a declaration, which the run loop installs
// as a verb rather than dispatching. A chat model wraps code in ``` about
// half the time, and the interpreter is owed source, not a transcript of one.
//
// COPY AT THE BOUNDARY (610_007 stage 2). This used to be `{ raw: string } ->
// string`, returning a SUB-SLICE of its input — a borrow travelling upward out
// of a tor, which is exactly what 610_007's ruling bans ("borrows flow down,
// never up"). Its callers then carried that slice of the store-held `reply`
// String through `remember-said`, `record` and `std/bridge:run`, safe only
// because nobody on those paths happens to touch the reply store. Nothing
// checked that, and `append`/`clear` on the owner would have killed the slice
// with no free anywhere in sight (610_008).
//
// Now the sub-slicing stays private in `clean-span` and `clean` hands back an
// OWNED `*String<view!>`. The copy carries an obligation, so it cannot leak the
// way a plain allocating `string` return would; the caller reads it, uses it,
// and frees it inside one visible flow. One memcpy of a chat line, once per
// turn, on a network boundary — the cost 610_007 priced as noise.
~pub tor clean { raw: string }
| ok *std/string:String<view!>
| err string

~clean = clean-span(raw): span |> std/string:from-page(text: span)
| ok s => ok s
| err e => err e

// The byte arithmetic, and nothing else. Deliberately NOT `pub`: its result is
// a sub-slice of `raw` and must not travel, so its one caller is the line above.
~tor clean-span { raw: string } -> string

~proc clean-span|zig {
    var s = std.mem.trim(u8, raw, " \t\r\n");

    if (std.mem.startsWith(u8, s, "```")) {
        const nl = std.mem.indexOfScalar(u8, s, '\n') orelse s.len;
        s = s[@min(nl + 1, s.len)..];
        if (std.mem.lastIndexOf(u8, s, "```")) |end| s = s[0..end];
        s = std.mem.trim(u8, s, " \t\r\n");
    }

    // A declaration is two lines, not one: `tor name { ... }` plus its body.
    // The run loop discriminates declaration from invocation, so the head of
    // a `tor `-led reply is both lines. Anything else, the head is the first
    // line. A tool call is a line, and this is the cheapest way to be strict
    // about that without pretending to parse Koru here.
    if (std.mem.startsWith(u8, s, "tor ")) {
        if (std.mem.indexOfScalar(u8, s, '\n')) |nl| {
            const rest = s[nl + 1 ..];
            const end = std.mem.indexOfScalar(u8, rest, '\n') orelse rest.len;
            return std.mem.trim(u8, s[0 .. nl + 1 + end], " \t\r");
        }
        return s;
    }
    if (std.mem.indexOfScalar(u8, s, '\n')) |nl| s = std.mem.trim(u8, s[0..nl], " \t\r");

    return s;
}

// How many lines of the reply did NOT run. The run loop executes the first
// invocation it is given (R2's wire gate refuses the rest at parse time) —
// with the one exception `clean` keeps: a `tor `-led declaration, whose two
// lines run as one install. `clean` enforces the head either way, but a drop the agent never
// hears about is a drop it will repeat. The `many` arm lets the caller say
// so; `one` covers the happy path, the whole-declaration path, and the
// empty reply alike. Fences are stripped before counting, the same way
// `clean-span` strips them before keeping: fence lines never ran, but they
// were never wire either.
~pub tor extra-lines { raw: string }
| one
| many u64

~proc extra-lines|zig {
    var s = std.mem.trim(u8, raw, " \t\r\n");
    if (s.len == 0) return .{ .one = .{} };
    if (std.mem.startsWith(u8, s, "```")) {
        const nl = std.mem.indexOfScalar(u8, s, '\n') orelse s.len;
        s = s[@min(nl + 1, s.len)..];
        if (std.mem.lastIndexOf(u8, s, "```")) |end| s = s[0..end];
        s = std.mem.trim(u8, s, " \t\r\n");
    }
    if (s.len == 0) return .{ .one = .{} };
    var n: u64 = 1;
    for (s) |ch| {
        if (ch == '\n') n += 1;
    }
    if (n <= 1) return .{ .one = .{} };
    if (n == 2 and std.mem.startsWith(u8, s, "tor ")) return .{ .one = .{} };
    return .{ .many = n };
}

// ============================================================================
// MESSAGE BUILDING — the transcript is bytes the store holds, built here
// ============================================================================

// One chat message, escaped and comma-prefixed, ready to append to the
// transcript String and splice straight into a request body.
~pub tor msg { role: string, content: string } -> string

~proc msg|zig {
    const alloc = std.heap.page_allocator;
    var out = std.ArrayListUnmanaged(u8){};
    out.appendSlice(alloc, ",{\"role\":\"") catch @panic("kopium: OOM");
    out.appendSlice(alloc, role) catch @panic("kopium: OOM");
    out.appendSlice(alloc, "\",\"content\":\"") catch @panic("kopium: OOM");
    jsonEscape(alloc, &out, content);
    out.appendSlice(alloc, "\"}") catch @panic("kopium: OOM");
    return out.toOwnedSlice(alloc) catch @panic("kopium: OOM");
}

// ============================================================================
// THE PROMPT — the vocabulary IS the `register` block, rendered for the model
// ============================================================================
//
// CLOSED 2026-08-13. This used to be duplication: `notes.kz` declared the
// agent's whole vocabulary in a form the compiler reads, and the prompt below
// restated the same facts in English — two sources of truth that drifted, with
// only `event-denied` at runtime to catch it. `std/runtime:scope-vocabulary`
// (koru b1c4ecb6 / 430_057) is the surface that was missing: a running program
// asks a scope what it holds and gets `name(arg: type<!obligation>)` lines
// straight out of the compiled descriptor. The prompt and the enforcement are
// the same bytes now; the prose below is guidance, not vocabulary.

// ============================================================================
// THE PROMPT — grammar AND vocabulary derived from the SESSION, refreshed
// every turn
// ============================================================================
//
// `auth` above is the model: read once at startup, held in a module buffer,
// read again through a proc. The prompt is NOT static — it comes from
// `std/bridge:grammar` (koru wire-grammar branch, 430_063 / 440_017), which
// renders the wire's shape rules — the same sentences `parse.wire` enforces
// on every turn — above the scope's COMPILED events PLUS the session's
// runtime-defined flows. An invention the agent defined on turn N appears in
// its own prompt on turn N+1, so the agent's growth loop closes: define →
// see → use. The lesson and the law are one declaration read twice; nothing
// about the grammar is hand-typed here anymore. The FLOW below keeps
// grammar as a real graph reference (a raw handler call out of a `|zig`
// body would be stripped by dead-code elimination, which only sees Koru graph
// edges). Callers re-warm per turn, once the bridge exists — `turn`/`act`
// invoke it with their `br` in hand.

~pub tor warm-grammar { br: *std/bridge:Bridge }

~warm-grammar = std/bridge:grammar(br)
| ok g |> remember-grammar(grammar: g)
| not-found _ |> remember-grammar(grammar: "!! bridge grammar: scope not found !!")

var grammar_buf: [4096]u8 = undefined;
var grammar_len: usize = 0;

~tor remember-grammar { grammar: string }

~proc remember-grammar|zig {
    if (grammar.len > $mod.grammar_buf.len) @panic("kopium: grammar too long for its buffer");
    @memcpy($mod.grammar_buf[0..grammar.len], grammar);
    $mod.grammar_len = grammar.len;
}

~pub tor agent-body { model: string, max_tokens: u32, temperature: string, goal: string, history: string } -> string

~proc agent-body|zig {
    const alloc = std.heap.page_allocator;
    const grammar = $mod.grammar_buf[0..$mod.grammar_len];

    const rules =
        \\You are driving a Koru interpreter. Your reply is Koru: one invocation
        \\per line. The run loop executes the first invocation it is given (a
        \\definition is two lines and is declared below) and drops the rest —
        \\lead with what matters. There is no prose channel: to say something,
        \\call say(). What you may call is your vocabulary below, derived from
        \\the session's own declaration:
        \\
    ;

    const rules2 =
        \\
        \\Session facts:
        \\- If the human is chatting, asking a question, or you are unsure what
        \\  they want, use say().
        \\- Handles are issued by open() and STILL OPEN — this session outlives
        \\  each turn.
        \\- If the action is impossible — wrong handle, missing handle,
        \\  out-of-vocabulary action, or you are stuck — call say(text: "...")
        \\  and explain why: the transcript is how the next turn learns.
        \\
        \\Examples of well-formed replies:
        \\say(text: "Not much — tell me a note to open.")
        \\say(text: "I opened chat.txt as note_0.")
        \\open(path: "notes.txt")
        \\append(handle: "note_0", text: "hello")
        \\close(handle: "note_0")
        \\
        \\Growth — teaching the session a new verb. A definition is the one reply
        \\that is TWO lines: the first line starts with `tor ` and declares the
        \\verb and its params, the second line is its body over verbs you already
        \\hold. The run loop installs it instead of dispatching it, and the next
        \\turn's vocabulary lists it beside the compiled verbs. Example:
        \\tor greet { msg: string }
        \\greet = say(text: msg)
    ;

    var out = std.ArrayListUnmanaged(u8){};
    // The model is a caller-supplied parameter, not a constant here: swapping
    // the test target is one literal at the call site, not a zig-embedded edit.
    out.appendSlice(alloc, "{\"model\":\"") catch @panic("kopium: OOM");
    out.appendSlice(alloc, model) catch @panic("kopium: OOM");
    // Budget is a parameter for the same reason: a reasoning model spends
    // tokens thinking before it emits the line (Muse Spark burned 20/20 on
    // reasoning under the old 100), so the cap rides with the model choice.
    out.appendSlice(alloc, "\",\"stream\":true,\"max_tokens\":") catch @panic("kopium: OOM");
    const budget = std.fmt.allocPrint(alloc, "{d}", .{max_tokens}) catch @panic("kopium: OOM");
    out.appendSlice(alloc, budget) catch @panic("kopium: OOM");
    // Temperature rides along as raw JSON-number text ("0", "0.7"): a float
    // tor param would raise format questions in the splice, and the caller
    // owns the value the same way it owns the model choice.
    out.appendSlice(alloc, ",\"temperature\":") catch @panic("kopium: OOM");
    out.appendSlice(alloc, temperature) catch @panic("kopium: OOM");
    out.appendSlice(alloc, ",\"stream_options\":{\"include_usage\":true},\"messages\":[{\"role\":\"system\",\"content\":\"") catch @panic("kopium: OOM");
    jsonEscape(alloc, &out, rules);
    jsonEscape(alloc, &out, grammar);
    jsonEscape(alloc, &out, rules2);
    out.appendSlice(alloc, "\"}") catch @panic("kopium: OOM");
    out.appendSlice(alloc, history) catch @panic("kopium: OOM");
    out.appendSlice(alloc, ",{\"role\":\"user\",\"content\":\"") catch @panic("kopium: OOM");
    jsonEscape(alloc, &out, goal);
    out.appendSlice(alloc, "\"}]}") catch @panic("kopium: OOM");
    return out.toOwnedSlice(alloc) catch @panic("kopium: OOM");
}

fn jsonEscape(alloc: std.mem.Allocator, out: *std.ArrayListUnmanaged(u8), text: []const u8) void {
    for (text) |ch| {
        switch (ch) {
            '"' => out.appendSlice(alloc, "\\\"") catch @panic("kopium: OOM"),
            '\\' => out.appendSlice(alloc, "\\\\") catch @panic("kopium: OOM"),
            '\n' => out.appendSlice(alloc, "\\n") catch @panic("kopium: OOM"),
            '\t' => out.appendSlice(alloc, "\\t") catch @panic("kopium: OOM"),
            else => {
                if (ch >= 0x20) out.append(alloc, ch) catch @panic("kopium: OOM");
            },
        }
    }
}
