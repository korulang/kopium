// The canned model.
//
// `d_turns.k` streams real replies from the live model over SSE. This file is
// that model with the network taken out and the answers written down, so the
// harness under test is the BRIDGE and not the transport. Swapping this tor for
// the live one is the whole difference between headless and wired.
//
// Handles are OPAQUE (Lars ruling 2026-09-07/08): nothing is predictable, so
// a cooperative model BINDS what the observation returned — the session hands
// the observed handle in as `handle`, and turns 2/6/7 format it into their
// source. Turn 3 is the deliberate counter-case: the model names a handle it
// was never given. That is not a hostile model, it is an ordinary one — a
// confident wrong answer is the single most likely thing an LLM emits, and it
// is the reason a tool surface needs a refusal rather than a validator. With
// opaque handles the wrong answer is a fabricATION, which makes the refusal
// even more load-bearing: nothing to predict, so a guess is proof of nothing.

const std = @import("std");

// Static formatting buffer — the returned slice must outlive this proc
// regardless of whether the interpreter dupes string returns.
var say_buf: [128]u8 = undefined;

~pub tor say { turn: u32 } -> string

~proc say|zig {
    // The observed handle: the module's mint record, read the way a real
    // model reads the transcript. Handles are opaque — this is the only
    // legal knowledge — and turns that USE a handle bind it (Lars ruling
    // 2026-09-07/08). Turn 3 deliberately fabricates instead: nothing is
    // predictable, so a guess is proof of nothing, and the refusal is the
    // tool surface's job.
    const notes = @import("root").koru_app.koru_notes;
    const last = notes.last_minted_event.handler(.{});
    return switch (turn) {
        1 => "open(path: \"agent-notes.txt\")",
        2 => std.fmt.bufPrint(&$mod.say_buf, "append(handle: \"{s}\", text: \"the bridge held this across a turn\")", .{last}) catch "append()",
        3 => "close(handle: \"deadbe\")",
        // The REPL rung: turn 4 DEFINES a verb through `run` — no separate
        // define verb, the run loop discriminates. Turn 5 calls it.
        4 => "tor greet { msg: string }\ngreet = say(text: msg)",
        5 => "greet(msg: \"hello from a defined flow\")",
        // Turn 6 is the drift case the live wire cannot produce anymore: the
        // prompt is derived, so a cooperative model never invents a verb —
        // but a fourth verb in the prompt makes it emit one instantly. The
        // canned turn keeps that wall witnessed without beating the odds.
        6 => std.fmt.bufPrint(&$mod.say_buf, "sync(handle: \"{s}\")", .{last}) catch "sync()",
        else => std.fmt.bufPrint(&$mod.say_buf, "close(handle: \"{s}\")", .{last}) catch "close()",
    };
}

// What the model *meant* by each turn, for the transcript. Prose only.
~pub tor intent { turn: u32 } -> string

~proc intent|zig {
    return switch (turn) {
        1 => "open a note",
        2 => "write into the note I opened last turn",
        3 => "close a fabricated handle (nobody ever gave me one)",
        4 => "teach the session a new verb that wraps a voice line",
        5 => "use the verb it just defined",
        6 => "sync the note (a verb nobody declared)",
        else => "close the note",
    };
}
