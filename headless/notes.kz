// The agent's ENTIRE vocabulary — three verbs over real files on disk.
//
// The `register` block at the bottom is the permission model. It is not a
// description of the tools; it is the allow-list the interpreter dispatches
// against, and an event the agent names that is not in it comes back
// `event-denied`. Tool permissions are a Koru declaration, read by the
// compiler, rather than a JSON schema checked by hand.
//
// `append` consumes `<!open>` and re-issues `<open!>` — the transaction shape
// (`tx.exec`), not a convenience. USING the note is what proves you hold it, so
// a forged handle is refused at `append` and not only at `close`. Model it as a
// plain `string` and the possession check covers teardown while leaving every
// read and write unguarded, which is the wrong half.

~import std/runtime

const std = @import("std");

const MAX_NOTES = 8;

var files: [MAX_NOTES]?std.fs.File = .{null} ** MAX_NOTES;
var opened: usize = 0;

// Handles are minted into module-held storage rather than allocated. A proc
// returning a bare `-> string` owns what it hands back, and nothing in the
// interpreter path frees it — the pool dupes into its own arena and releases
// that copy, so an allocPrint here is a leak the produced program's counter
// catches on the way out. `wired/auth.kz` reaches for the same pattern.
var handle_buf: [MAX_NOTES][16]u8 = undefined;
var handle_len: [MAX_NOTES]usize = .{0} ** MAX_NOTES;

// The most recently minted handle, kept for the inspection seam below.
// `last-minted` is how a session or probe reads what the module just minted
// — the live agent never needs it (it reads observations); canned sessions
// and probes use it to BIND rather than predict.
var last_minted_buf: [16]u8 = undefined;
var last_minted_len: usize = 0;

// OPAQUE MINT (Lars ruling 2026-09-07/08): a handle is 6 lowercase hex,
// mixed from a per-process seed — nothing to predict across sessions, and
// consecutive mints within a session differ. The only legal access is
// binding what an observation returned; a fabricated name dies at the pool.
var mint_seed: u64 = 0;
var mint_count: u32 = 0;

fn slotOf(
    handle: []const u8,
    mod_files: [MAX_NOTES]?std.fs.File,
    mod_opened: usize,
    mod_handle_buf: [MAX_NOTES][16]u8,
    mod_handle_len: [MAX_NOTES]usize,
) ?usize {
    // Handles are opaque 6-hex, so the name encodes nothing — possession is
    // proven by matching the live slot's stored mint. The interpreter has
    // already refused any handle this pool never issued, so a match here is
    // the module's own proof the caller holds it. (Plain `fn`s cannot see
    // `$mod`; callers pass the module state in, where `$mod` rewrites.)
    var s: usize = 0;
    while (s < mod_opened) : (s += 1) {
        if (mod_files[s] != null and
            std.mem.eql(u8, mod_handle_buf[s][0..mod_handle_len[s]], handle))
        {
            return s;
        }
    }
    return null;
}

// ============================================================================

~pub tor open { path: string } -> string<open!>

~proc open|zig {
    // Slots recycle: close frees the fd but not the name, and `opened` only
    // ever grew — the ninth open in a process panicked. A closed slot is
    // reusable: the pool tells discharged obligations from live ones, so a
    // re-minted `note_N` names the new file, never the old. Lowest free
    // slot first, keeping names dense and deterministic.
    var slot: usize = 0;
    while (slot < $mod.opened) : (slot += 1) {
        if ($mod.files[slot] == null) break;
    } else {
        slot = $mod.opened;
        if (slot >= MAX_NOTES) @panic("notes: too many open notes");
        $mod.opened += 1;
    }

    const f = std.fs.cwd().createFile(path, .{ .truncate = true }) catch |e| {
        std.debug.panic("notes: could not create '{s}': {s}", .{ path, @errorName(e) });
    };
    $mod.files[slot] = f;

    if ($mod.mint_seed == 0) {
        $mod.mint_seed = std.crypto.random.int(u64);
    }
    // Splitmix-style avalanche over (seed, count): two opens in one session
    // differ, and a fresh process starts from a fresh seed.
    var mix = $mod.mint_seed;
    mix ^= mix >> 33;
    mix *%= 0xff51afd7ed558ccd;
    mix ^= mix >> 33;
    mix +%= @as(u64, $mod.mint_count + 1) *% 0x9e3779b97f4a7c15;
    mix ^= mix >> 33;
    $mod.mint_count += 1;

    // Uniqueness among LIVE handles: re-mix on collision (24-bit space, at
    // most MAX_NOTES live — a retry loop is the honest guard, not a panic).
    var candidate: [8]u8 = undefined;
    var attempts: u32 = 0;
    while (true) : (attempts += 1) {
        const c = std.fmt.bufPrint(&candidate, "{x:0>6}", .{@as(u24, @truncate(mix))}) catch @panic("notes: handle too long");
        var collides = false;
        for (0..$mod.opened) |s| {
            if ($mod.files[s] != null and
                std.mem.eql(u8, $mod.handle_buf[s][0..$mod.handle_len[s]], c))
            {
                collides = true;
                break;
            }
        }
        if (!collides) {
            @memcpy($mod.handle_buf[slot][0..c.len], c);
            $mod.handle_len[slot] = c.len;
            break;
        }
        if (attempts > 32) @panic("notes: handle collision after retries");
        mix ^= mix >> 33;
        mix *%= 0xbf58476d1ce4e5b9;
        mix ^= mix >> 29;
    }
    $mod.last_minted_len = $mod.handle_len[slot];
    @memcpy($mod.last_minted_buf[0..$mod.handle_len[slot]], $mod.handle_buf[slot][0..$mod.handle_len[slot]]);
    return $mod.handle_buf[slot][0..$mod.handle_len[slot]];
}

~pub tor append { handle: string<!open>, text: string } -> string<open!>

~proc append|zig {
    const slot = slotOf(handle, $mod.files, $mod.opened, $mod.handle_buf, $mod.handle_len) orelse @panic("notes: append on a handle this module never minted");
    const f = $mod.files[slot] orelse @panic("notes: append on a closed note");
    f.writeAll(text) catch @panic("notes: write failed");
    f.writeAll("\n") catch @panic("notes: write failed");
    return handle;
}

~pub tor close { handle: string<!open> }

~proc close|zig {
    const slot = slotOf(handle, $mod.files, $mod.opened, $mod.handle_buf, $mod.handle_len) orelse @panic("notes: close on a handle this module never minted");
    if ($mod.files[slot]) |f| {
        f.close();
        $mod.files[slot] = null;
        if (!$mod.quiet) std.debug.print("      [disk] note closed, fd released\n", .{});
    }
}

// ============================================================================
// LAST-MINTED — the inspection seam (NOT in the register)
// ============================================================================
//
// What the module just minted. The live agent never calls this — it reads
// the observation (the result carries the handle) — but canned sessions and
// probes must BIND, and binding needs the actual mint. This tor is how a
// session reads the resource world it just changed. Deliberately absent from
// the register below: the agent's vocabulary stays the six verbs, and a
// handle is never something to ask for — it is something you were given.

~[retain]pub tor last-minted {} -> string

~proc last-minted|zig {
    return $mod.last_minted_buf[0..$mod.last_minted_len];
}

// ============================================================================
// READ — the bridge's eyes, and the smallest wall that fits them
// ============================================================================
//
// Forced by the py-expr-eval family (vulcan-forcing 2026-09-07): file tasks
// need file-read — the bridge cannot see code it cannot open. Before this
// verb the agent could create and truncate (`open`) but never look at what
// was already on disk; every file-task attempt died at the first step.
//
// Scope rules (read-only, nothing minted):
//   - `openFile(path, .{})`: no create, no truncate, no write. `open` above
//     is the destructive verb; this one cannot modify the disk by
//     construction, only witness it.
//   - Named branches, no handle minted, no obligation issued: `| ok` and
//     `| missing path` are outcomes, not resources. Contrast koru
//     335_042 (`std/io:read-file`'s buffer carries `allocated!` and MUST
//     reach `std/io:free`): no Koru-visible buffer ever exists here, so
//     there is nothing to discharge — the bytes travel the `say` channel
//     (stderr transcript, quiet-gated) and die there.
//   - A missing file is `| missing path`, not a panic: the verb runs,
//     reports, and the bridge survives for the next turn — the same shape
//     as `std/io:read-file`'s `not-found` arm (live.k leans on it). The
//     named outcome is also the live trigger for the ruling's hand-back
//     (430_056): a fragment that does not handle `missing` hands it back as
//     `unhandled-branch`, and the host (live.k's `act`) feeds the model what
//     it left on the bridge.
// Read opens. It does not run: evaluation is a later verb.

~pub tor read { path: string }
| ok
| missing string

~proc read|zig {
    const f = std.fs.cwd().openFile(path, .{}) catch {
        if (!$mod.quiet) std.debug.print("      [read] not-found: '{s}'\n", .{path});
        return .{ .missing = path };
    };
    defer f.close();
    var buf: [4096]u8 = undefined;
    while (true) {
        const n = f.read(&buf) catch @panic("notes: read failed");
        if (n == 0) break;
        if (!$mod.quiet) std.debug.print("{s}", .{buf[0..n]});
    }
    if (!$mod.quiet) std.debug.print("\n      [read] ok: '{s}'\n", .{path});
    return .ok;
}

// ============================================================================
// EDIT — the bridge's hands, and the smallest wall that fits them
// ============================================================================
//
// Forced by the go-stack-pop-bug family (vulcan-forcing 2026-09-07): mutation
// tasks need file-edit — the bridge can open a file's eyes (read) but not
// its hands. Before this verb the attempt ended at reading; the patch landed
// by hand because no declared verb could change the disk.
//
// Scope rules (existing-only, exactly-once — both can be wrong, both refuse):
//   - Phase 1 is read-only: `openFile(path, .{})`, never `createFile`. A
//     missing file is a printed `not-found` and nothing is written —
//     `open` above is the creating verb; this one cannot mint a file by
//     construction. Same shape as `read` and `std/io:read-file`'s
//     `not-found` arm.
//   - The needle must match EXACTLY ONCE. Zero matches is a printed
//     `mismatch`, more than one is a printed `ambiguous` refusal — either
//     way nothing is written. An empty needle never matches.
//   - Phase 2 writes only after phase 1 accepted: single splice,
//     truncate-write, printed `ok`. Read-only-then-write pairing — the
//     write has no path that skips the match check.
//   - `-> void`: no handle minted, no obligation issued. The bytes never
//     enter Koru values (transcript channel only, quiet-gated), so there is
//     nothing to discharge — same possession shape as `read`.
//   - Bounded honesty: files past 64KiB are refused LOUD (`too-large`),
//     never silently truncated. No allocator is touched, so the cap is the
//     price of staying allocation-free.
// Pun-dodge: the invocation lives inside a bridge `source:` string, parsed
// at runtime — never as a Koru callee the compiler binds — so the KORU080
// bare-identifier pun class has no site here by construction.

~pub tor edit { path: string, old_text: string, new_text: string }

~proc edit|zig {
    if (old_text.len == 0) {
        if (!$mod.quiet) std.debug.print("      [edit] mismatch: empty needle never matches\n", .{});
        return;
    }
    const f = std.fs.cwd().openFile(path, .{}) catch {
        if (!$mod.quiet) std.debug.print("      [edit] not-found: '{s}'\n", .{path});
        return;
    };
    var buf: [65536]u8 = undefined;
    var len: usize = 0;
    while (true) {
        const n = f.read(buf[len..]) catch {
            f.close();
            @panic("notes: edit read failed");
        };
        if (n == 0) break;
        len += n;
        if (len == buf.len) {
            const more = f.read(buf[0..1]) catch {
                f.close();
                @panic("notes: edit read failed");
            };
            f.close();
            if (more != 0) {
                if (!$mod.quiet) std.debug.print("      [edit] too-large: '{s}' exceeds 64KiB — refusing\n", .{path});
                return;
            }
            break;
        }
    }
    f.close();
    const content = buf[0..len];
    var count: usize = 0;
    var from: usize = 0;
    while (std.mem.indexOf(u8, content[from..], old_text)) |rel| {
        count += 1;
        if (count > 1) break;
        from += rel + old_text.len;
    }
    if (count == 0) {
        if (!$mod.quiet) std.debug.print("      [edit] mismatch: needle not found in '{s}'\n", .{path});
        return;
    }
    if (count > 1) {
        if (!$mod.quiet) std.debug.print("      [edit] ambiguous: needle matches more than once in '{s}' — refusing\n", .{path});
        return;
    }
    const at = std.mem.indexOf(u8, content, old_text) orelse @panic("notes: edit splice failed");
    const out = std.fs.cwd().createFile(path, .{}) catch @panic("notes: edit write failed");
    defer out.close();
    out.writeAll(content[0..at]) catch @panic("notes: edit write failed");
    out.writeAll(new_text) catch @panic("notes: edit write failed");
    out.writeAll(content[at + old_text.len ..]) catch @panic("notes: edit write failed");
    if (!$mod.quiet) std.debug.print("\n      [edit] ok: '{s}'\n", .{path});
}



// ============================================================================
// HUSH — a TUI owns the terminal, and these procs do not
// ============================================================================
//
// `std.debug.print` goes to stderr, straight at the terminal, while vaxis
// renders the screen on stdout with cursor positioning. Two writers, one
// terminal: the output interleaves character by character and the pane turns to
// noise. Harmless in session.k and live.k, where the prints ARE the output;
// fatal the moment there is a screen.
//
// headed.k calls this once at startup. The transcript still shows every
// invocation, so nothing is lost — the app renders, the module stops shouting.

var quiet: bool = false;

~pub tor hush {}

~proc hush|zig {
    $mod.quiet = true;
}

// ============================================================================
// SAY — the agent's voice, and it is a TOOL CALL like any other
// ============================================================================
//
// Added 2026-08-07 after Lars typed "Hey, what's up?" at the TUI and the agent
// opened a file. That was not the model improvising: the prompt said "reply
// with ONE invocation and nothing else, no prose", so a conversational turn had
// NO legal answer and the model picked the most plausible verb it had.
//
// The fix is not a prose escape hatch. Speaking is something the agent does, so
// it belongs in the vocabulary where every other thing it does lives — declared
// in the register block, dispatched through the interpreter, refusable. The
// permission model then covers talking too, which a side channel would not.
//
// It holds no resource and mints no obligation: saying something is the one
// verb here with nothing to clean up.

~pub tor say { text: string }

~proc say|zig {
    if (!$mod.quiet) std.debug.print("      {s}\n", .{text});
}

// ============================================================================
// THE PERMISSION MODEL
// ============================================================================
//
// Everything the agent may call, and nothing else. The numbers are per-call
// costs — the budget knob the interpreter already carries. Metering is parked
// as a feature, so nothing here sets a limit; the costs are declared because
// this is the shape that would want one first.

~std/runtime:register(scope: "notes") {
    open(10)
    append(1)
    close(1)
    say(1)
    read(1)
    edit(1)
}
